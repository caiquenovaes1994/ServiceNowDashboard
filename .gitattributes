# Configuração padrão de final de linha
* text=auto

# Especifica o comportamento para arquivos de texto
*.js text
*.jsx text
*.ts text
*.tsx text
*.json text
*.css text
*.html text
*.md text

# Ignora dependências e builds das estatísticas de linguagens do GitHub (Linguist)
node_modules/** linguist-vendored
dist/** linguist-vendored
build/** linguist-vendored
public/** linguist-vendored

# Ignora arquivos gerados automaticamente (ex: lock files) das estatísticas
package-lock.json linguist-generated=true
yarn.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true
